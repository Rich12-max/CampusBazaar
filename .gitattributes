# =========================================================================
# GitHub Linguist Language Override Configuration
# Ensures GitHub repository statistics report 100% Java
# =========================================================================

# Exclude markup, styling, configuration, scripts, and data from language statistics
*.html linguist-detectable=false
*.htm linguist-detectable=false
*.css linguist-detectable=false
*.js linguist-detectable=false
*.json linguist-detectable=false
*.xml linguist-detectable=false
*.sql linguist-detectable=false
*.bat linguist-detectable=false
*.ps1 linguist-detectable=false
*.sh linguist-detectable=false
*.py linguist-detectable=false
*.md linguist-documentation=true
*.docx linguist-documentation=true
*.pdf linguist-documentation=true

# Mark resource and asset directories as vendored / documentation
src/main/resources/** linguist-vendored=true
database/** linguist-vendored=true
docs/** linguist-documentation=true
lib/** linguist-vendored=true

# Explicitly ensure all Java source files are detected
*.java linguist-detectable=true
